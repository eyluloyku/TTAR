outputs/*
!outputs/figures/
!outputs/diagnostics/
outputs/diagnostics/**
!outputs/diagnostics/**/
!outputs/diagnostics/**/FINDINGS*.md
!outputs/diagnostics/boundary_phase0/results.json
checkpoints/
logs/
wandb/
runs/
*.ckpt
*.pt
*.pth

# Submissions
submissions/
*.csv.gz

# Data (never commit data; it lives on the cluster)
data/
*.npy
*.npz

# IDE / OS
.vscode/
.idea/
.DS_Store

# SLURM stdout/stderr
slurm-*.out
*.err
